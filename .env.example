DEBUG=True
SECRET_KEY=your_secret_key
DJANGO_SETTINGS_MODULE=config.settings.development

# Database
DATABASE_URL=sqlite:///db.sqlite3
XOFI_ERP_DATABASE_URL=sqlite:///../xofi-erp/db.sqlite3

# Redis & Celery
REDIS_URL=redis://127.0.0.1:6379/

# Email Configuration
EMAIL_HOST=live.smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Project Name.us <site@knowing.labs.lis.us>"

# WhatsApp Provider Selection
# Opciones: meta, whapi, bulkgate
WHATSAPP_PROVIDER=whapi

# WhatsApp Business API Configuration (Meta Provider)
# Obtener estas credenciales en: https://developers.facebook.com/apps/
WHATSAPP_API_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_API_VERSION=v21.0

# Whapi Configuration (WHAPI Provider)
# Crear cuenta en Whapi: https://whapi.io/
WHAPI_API_URL=https://gate.whapi.cloud
WHAPI_API_TOKEN=your_whapi_api_token_here

# Telegram Bot API Configuration
# Crear bot con @BotFather en Telegram: https://t.me/botfather
# Documentación: https://core.telegram.org/bots/api
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# BulkGate Multi-Channel Configuration
# Crear cuenta en BulkGate: https://www.bulkgate.com/
# Documentación: https://help.bulkgate.com/docs/en/http-advanced-transactional-v2.html
# BulkGate se puede usar como proveedor de SMS y WhatsApp
BULKGATE_APPLICATION_ID=your_application_id_here
BULKGATE_APPLICATION_TOKEN=your_application_token_here
BULKGATE_DEFAULT_SENDER=YourCompany
BULKGATE_DEFAULT_COUNTRY=PE

# BulkGate - Canales adicionales (opcional)
BULKGATE_ENABLE_VIBER=False
BULKGATE_ENABLE_WHATSAPP=False
BULKGATE_ENABLE_RCS=False

# BulkGate - WhatsApp con fallback a SMS
# Si el mensaje de WhatsApp falla, automáticamente envía por SMS
BULKGATE_WHATSAPP_SMS_FALLBACK=True

# Proveedor SMS por defecto
# Opciones: bulkgate (más opciones en el futuro)
SMS_PROVIDER=bulkgate

# Culqi Payment Gateway Configuration
# Crea una cuenta en Culqi: https://www.culqi.com/

CULQI_PUBLIC_KEY=pk_test_XXXXXXX
CULQI_PRIVATE_KEY=sk_test_XXXXXXX
CULQI_RSA_ID=your_rsa_id_here
CULQI_RSA_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----your_rsa_public_key_here-----END PUBLIC KEY-----
CORS_ALLOWED_ORIGINS=http://localhost:8000,https://checkout.culqi.com

# Google Gemini AI Configuration
# Get API key from https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.0-flash-lite

# Internal API Configuration
# Token for authenticating internal API calls
AI_AGENT_API_BASE_URL=http://localhost:8000
AI_AGENT_API_TOKEN=your_secure_api_token_here
